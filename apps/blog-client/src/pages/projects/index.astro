---
import useDemo from "../../hooks/useDemo";
import Layout from "../../layouts/Layout.astro";

const { renderDemo } = useDemo();

const DemoPage = renderDemo({
  demoKey: "nutritionist",
  path: "projects",
});
---

{
  DemoPage ? (
    <DemoPage />
  ) : (
    <Layout title="Proyectos">
      <h1>Projects</h1>
    </Layout>
  )
}
