---
import useDemo from "../../hooks/useDemo";
import Layout from "../../layouts/Layout.astro";

const { renderDemo } = useDemo();

const DemoPage = renderDemo({
  demoKey: "nutritionist",
  path: "services",
});
---

{
  DemoPage ? (
    <DemoPage />
  ) : (
    <Layout title="Servicios">
      <h1>Services</h1>
    </Layout>
  )
}
