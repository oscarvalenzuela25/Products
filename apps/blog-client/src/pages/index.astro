---
import useDemo from "../hooks/useDemo";
import Layout from "../layouts/Layout.astro";

const { renderDemo } = useDemo();

const DemoPage = renderDemo({
  demoKey: "nutritionist",
  path: "home",
});
---

{
  DemoPage ? (
    <DemoPage />
  ) : (
    <Layout title="Inicio">
      <h1>Hola mundo esto es el inicio</h1>
    </Layout>
  )
}
