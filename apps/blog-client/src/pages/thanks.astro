---
import useDemo from "../hooks/useDemo";
import Layout from "../layouts/Layout.astro";

const { renderDemo } = useDemo();

const DemoPage = renderDemo({
  demoKey: "nutritionist",
  path: "thanks",
});
---

{
  DemoPage ? (
    <DemoPage />
  ) : (
    <Layout title="Gracias!">
      <h1>Thank You</h1>
    </Layout>
  )
}
