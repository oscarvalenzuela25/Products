---
import useDemo from "../../hooks/useDemo";
import Layout from "../../layouts/Layout.astro";

const { renderDemo } = useDemo();

const DemoPage = renderDemo({
  demoKey: "nutritionist",
  path: "blog",
});
---

{
  DemoPage ? (
    <DemoPage />
  ) : (
    <Layout title="Blog">
      <h1>Hola mundo esto es el blog</h1>
    </Layout>
  )
}
