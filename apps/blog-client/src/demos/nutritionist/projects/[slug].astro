---
import NutritionistLayout from "../components/NutritionistLayout.astro";
import { stories } from "../data";

const { slug } = Astro.params;
const story = stories.find((item) => item.slug === slug);
---

{story ? (
  <NutritionistLayout title={`${story.title} | Historia de proceso`} description={story.excerpt} currentPath="/projects" image={story.image}>
    <article>
      <header class="story-hero">
        <div class="shell story-hero-copy"><div><p class="eyebrow">{story.category}</p><h1>{story.title}</h1><p class="lead">{story.excerpt}</p><span>{story.metric}</span></div></div>
        <div class="shell story-photo"><img src={story.image} alt={`Escena que representa la historia: ${story.title}`} width="1400" height="760" fetchpriority="high" /></div>
      </header>
      <section class="section story-content"><div class="shell content-grid"><aside><p>Historia adaptada</p><span>Nombre y detalles personales modificados para proteger la privacidad.</span></aside><div><section><p class="eyebrow">El punto de partida</p><h2>Lo que estaba pasando</h2><p>{story.challenge}</p></section><section><p class="eyebrow">El acompañamiento</p><h2>Lo que trabajamos</h2><p>{story.process}</p></section><blockquote><p>“{story.quote}”</p><footer>— Testimonio compartido al cierre del proceso</footer></blockquote><section><p class="eyebrow">El cambio sostenible</p><h2>Lo que se llevó</h2><p>{story.result}</p></section></div></div></section>
      <section class="section story-next"><div class="shell"><p class="eyebrow">Tu proceso no tiene que verse igual</p><h2>Puede empezar con una conversación honesta.</h2><a class="button" href="/contact">Contarle a Claudia qué necesito <span aria-hidden="true">→</span></a></div></section>
    </article>
  </NutritionistLayout>
) : (
  <NutritionistLayout title="Historia no encontrada | Claudia Valenzuela" description="La historia que buscas no está disponible." noIndex><section class="section missing"><div class="shell"><p class="eyebrow">Historia no encontrada</p><h1>Este enlace ya no está disponible.</h1><a class="button" href="/projects">Volver a historias</a></div></section></NutritionistLayout>
)}

<style>
  .story-hero { padding: clamp(4rem, 8vw, 7rem) 0 0; background: var(--surface); }
  .story-hero-copy { text-align: center; }
  .story-hero-copy .eyebrow { justify-content: center; }
  .story-hero-copy h1 { max-width: 13ch; margin-inline: auto; font-size: clamp(3.3rem, 8vw, 7rem); }
  .story-hero-copy .lead { max-width: 42rem; margin: 0 auto 1.5rem; }
  .story-hero-copy span { color: var(--green); font-size: .72rem; font-weight: 700; }
  .story-photo { transform: translateY(4rem); }
  .story-photo img { width: 100%; max-height: 42rem; border-radius: 2rem; object-fit: cover; }
  .story-content { padding-top: clamp(9rem, 15vw, 13rem); background: var(--cream); }
  .content-grid { display: grid; grid-template-columns: .34fr 1fr; gap: clamp(3rem, 9vw, 8rem); }
  .content-grid aside { position: sticky; top: 2rem; align-self: start; border-top: 2px solid var(--terracotta); padding-top: 1rem; }
  .content-grid aside p { margin-bottom: .35rem; color: var(--greenDark); font-size: .72rem; font-weight: 700; text-transform: uppercase; }
  .content-grid aside span { color: var(--muted); font-size: .7rem; }
  .content-grid section { max-width: 45rem; margin-bottom: 5rem; }
  .content-grid section h2 { font-size: clamp(2.4rem, 5vw, 4rem); }
  .content-grid section > p:last-child { color: var(--muted); font-size: 1.08rem; }
  blockquote { margin: 6rem 0; border-radius: 2rem; padding: clamp(2rem, 5vw, 4rem); background: var(--limeLight); }
  blockquote p { font-family: var(--font-display); font-size: clamp(2rem, 4vw, 3.4rem); line-height: 1.12; }
  blockquote footer { color: var(--muted); font-size: .7rem; }
  .story-next { background: var(--yellow); text-align: center; }
  .story-next .eyebrow { justify-content: center; }
  .story-next h2 { max-width: 16ch; margin-inline: auto; }
  .missing { min-height: 65vh; background: var(--surface); }
  .missing h1 { max-width: 12ch; font-size: clamp(3rem, 7vw, 6rem); }
  @media (max-width: 720px) { .content-grid { grid-template-columns: 1fr; } .content-grid aside { position: static; } }
</style>
