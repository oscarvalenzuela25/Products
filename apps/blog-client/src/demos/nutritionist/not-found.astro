---
import NutritionistLayout from "./components/NutritionistLayout.astro";
---

<NutritionistLayout title="Página no encontrada | Claudia Valenzuela" description="La página que buscas no está disponible." noIndex>
  <section class="not-found-section">
    <div class="shell not-found-grid">
      <div><p class="error-code" aria-hidden="true">404</p><p class="eyebrow">Página no encontrada</p><h1>Parece que esta receta perdió un ingrediente.</h1><p class="lead">El enlace pudo cambiar o la página ya no existe. Volvamos a un lugar conocido.</p><div><a class="button" href="/">Volver al inicio</a><a class="text-link" href="/contact">Pedir ayuda <span aria-hidden="true">→</span></a></div></div>
      <div class="plate" aria-hidden="true"><span></span><i></i><b></b></div>
    </div>
  </section>
</NutritionistLayout>

<style>
  .not-found-section { overflow: hidden; display: grid; min-height: 75vh; place-items: center; padding: clamp(4rem, 8vw, 8rem) 0; background: var(--surface); }
  .not-found-grid { display: grid; grid-template-columns: 1fr .65fr; align-items: center; gap: clamp(3rem, 8vw, 8rem); }
  .error-code { margin-bottom: -1rem; color: var(--terracotta); font-family: var(--font-display); font-size: 1.2rem; }
  .not-found-grid h1 { max-width: 11ch; font-size: clamp(3.3rem, 7vw, 6.5rem); }
  .not-found-grid .lead { max-width: 37rem; }
  .not-found-grid > div:first-child > div { display: flex; align-items: center; gap: 1.5rem; margin-top: 2rem; }
  .plate { position: relative; width: min(27rem, 80vw); aspect-ratio: 1; border: 1.8rem solid white; border-radius: 50%; background: var(--limeLight); box-shadow: inset 0 0 0 1px var(--border), var(--shadow-soft); }
  .plate span, .plate i, .plate b { position: absolute; display: block; border-radius: 80% 20% 80% 20%; }
  .plate span { width: 7rem; height: 3.5rem; top: 30%; left: 26%; background: var(--green); transform: rotate(35deg); }
  .plate i { width: 6rem; height: 3rem; top: 43%; right: 22%; background: var(--terracotta); transform: rotate(-28deg); }
  .plate b { width: 5rem; height: 5rem; bottom: 20%; left: 35%; border-radius: 50%; background: var(--yellow); }
  @media (max-width: 760px) { .not-found-grid { grid-template-columns: 1fr; } .plate { display: none; } }
  @media (max-width: 500px) { .not-found-grid > div:first-child > div { align-items: flex-start; flex-direction: column; } }
</style>
