---
import ArticleCard from "../components/ArticleCard.astro";
import NutritionistLayout from "../components/NutritionistLayout.astro";
import { articles } from "../data";

const { slug } = Astro.params;
const article = articles.find((item) => item.slug === slug);
const related = articles.filter((item) => item.slug !== slug).slice(0, 2);
---

{article ? (
  <NutritionistLayout title={`${article.title} | Claudia Valenzuela`} description={article.excerpt} currentPath="/blog" image={article.image}>
    <article>
      <header class="article-hero">
        <div class="shell article-heading"><p class="eyebrow">{article.category}</p><h1>{article.title}</h1><p class="lead">{article.excerpt}</p><div><time>{article.date}</time><span>{article.readingTime} de lectura</span></div></div>
        <div class="shell article-cover"><img src={article.image} alt={`Portada del artículo ${article.title}`} width="1400" height="820" fetchpriority="high" /></div>
      </header>
      <section class="article-content section"><div class="shell reading-grid"><aside><span>Compartir</span><a href={`mailto:?subject=${encodeURIComponent(article.title)}&body=${encodeURIComponent(Astro.url.href)}`}>Correo</a><a href="/contact">Consultar</a></aside><div class="prose"><p class="article-lead">{article.lead}</p>{article.sections.map((section) => <section><h2>{section.title}</h2><p>{section.body}</p></section>)}<div class="gentle-note"><strong>Una nota importante</strong><p>Este contenido es educativo y no reemplaza una evaluación individual. Si algo de lo que lees te genera preocupación, conversemos con calma.</p></div></div></div></section>
      <section class="author-section"><div class="shell author-card"><div class="author-avatar">CV</div><div><p>Escrito por</p><h2>Claudia Valenzuela</h2><span>Nutricionista · Más de 6 años de experiencia en atención clínica y conducta alimentaria.</span></div><a class="button button-outline" href="/about">Conocer a Claudia</a></div></section>
      <section class="section related-section"><div class="shell"><div class="related-heading"><p class="eyebrow">Sigue leyendo</p><h2>Más recursos para ti</h2></div><div class="related-grid">{related.map((item) => <ArticleCard article={item} />)}</div></div></section>
    </article>
  </NutritionistLayout>
) : (
  <NutritionistLayout title="Artículo no encontrado | Claudia Valenzuela" description="El artículo que buscas no está disponible." noIndex><section class="section missing"><div class="shell"><p class="eyebrow">Artículo no encontrado</p><h1>Esta lectura ya no está disponible.</h1><a class="button" href="/blog">Volver a recursos</a></div></section></NutritionistLayout>
)}

<style>
  .article-hero { padding: clamp(4rem, 8vw, 7rem) 0 0; background: var(--surface); text-align: center; }
  .article-heading .eyebrow { justify-content: center; }
  .article-heading h1 { max-width: 13ch; margin-inline: auto; font-size: clamp(3.2rem, 7vw, 6.2rem); }
  .article-heading .lead { max-width: 43rem; margin: 0 auto 1.5rem; }
  .article-heading > div { display: flex; justify-content: center; gap: 1rem; color: var(--muted); font-size: .7rem; }
  .article-cover { transform: translateY(4rem); }
  .article-cover img { width: 100%; max-height: 42rem; border-radius: 2rem; object-fit: cover; }
  .article-content { padding-top: clamp(9rem, 15vw, 13rem); background: var(--cream); }
  .reading-grid { display: grid; grid-template-columns: .25fr 1fr; gap: clamp(2rem, 8vw, 7rem); }
  .reading-grid aside { position: sticky; top: 2rem; display: flex; align-self: start; flex-direction: column; border-top: 2px solid var(--terracotta); padding-top: 1rem; }
  .reading-grid aside span { margin-bottom: .8rem; color: var(--muted); font-size: .65rem; font-weight: 700; text-transform: uppercase; }
  .reading-grid aside a { min-height: 2rem; color: var(--green); font-size: .74rem; font-weight: 700; }
  .prose { max-width: 46rem; }
  .article-lead { margin-bottom: 3.5rem; color: var(--greenDark); font-family: var(--font-display); font-size: clamp(1.8rem, 3vw, 2.5rem); line-height: 1.3; }
  .prose section { margin: 4rem 0; }
  .prose section h2 { font-size: clamp(2.3rem, 4vw, 3.4rem); }
  .prose section p { color: var(--muted); font-size: 1.05rem; line-height: 1.85; }
  .gentle-note { border-left: 3px solid var(--yellow); border-radius: 0 1rem 1rem 0; padding: 1.5rem; background: var(--surface); }
  .gentle-note strong { color: var(--greenDark); }
  .gentle-note p { margin: .5rem 0 0; color: var(--muted); font-size: .86rem; }
  .author-section { background: var(--cream); }
  .author-card { display: grid; grid-template-columns: auto 1fr auto; align-items: center; gap: 1.5rem; border-block: 1px solid var(--border); padding-block: 2.5rem; }
  .author-avatar { display: grid; width: 5rem; height: 5rem; place-items: center; border-radius: 50%; background: var(--limeLight); color: var(--green); font-family: var(--font-display); font-size: 1.5rem; }
  .author-card p { margin: 0; color: var(--muted); font-size: .65rem; text-transform: uppercase; }
  .author-card h2 { margin: .25rem 0; font-size: 1.8rem; }
  .author-card span { color: var(--muted); font-size: .74rem; }
  .related-section { background: var(--cream); }
  .related-heading h2 { font-size: clamp(2.5rem, 5vw, 4rem); }
  .related-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
  .missing { min-height: 65vh; background: var(--surface); }
  .missing h1 { max-width: 12ch; font-size: clamp(3rem, 7vw, 6rem); }
  @media (max-width: 720px) { .reading-grid { grid-template-columns: 1fr; } .reading-grid aside { position: static; flex-direction: row; gap: 1rem; } .author-card { grid-template-columns: auto 1fr; } .author-card .button { grid-column: 1 / -1; } .related-grid { grid-template-columns: 1fr; } }
</style>
