---
interface Props {
  article: {
    slug: string;
    category: string;
    title: string;
    excerpt: string;
    date: string;
    readingTime: string;
    image: string;
  };
  featured?: boolean;
}

const { article, featured = false } = Astro.props;
---

<article class:list={["article-card", { featured }]}>
  <a class="article-image" href={`/blog/${article.slug}`} tabindex="-1" aria-hidden="true">
    <img src={article.image} alt="" width="760" height="540" loading="lazy" />
  </a>
  <div class="article-body">
    <div class="article-meta"><span>{article.category}</span><span>{article.readingTime} de lectura</span></div>
    <h3><a href={`/blog/${article.slug}`}>{article.title}</a></h3>
    <p>{article.excerpt}</p>
    <div class="article-bottom"><time>{article.date}</time><a class="article-arrow" href={`/blog/${article.slug}`} aria-label={`Leer ${article.title}`}>→</a></div>
  </div>
</article>

<style>
  .article-card { overflow: hidden; border: 1px solid var(--border); border-radius: var(--radius-md); background: var(--paper); }
  .article-image { display: block; overflow: hidden; }
  .article-image img { width: 100%; aspect-ratio: 1.35; object-fit: cover; transition: transform .5s ease; }
  .article-card:hover .article-image img { transform: scale(1.035); }
  .article-body { padding: 1.5rem; }
  .article-meta, .article-bottom { display: flex; align-items: center; justify-content: space-between; gap: 1rem; }
  .article-meta { margin-bottom: 1.25rem; color: var(--green); font-size: .64rem; font-weight: 700; letter-spacing: .06em; text-transform: uppercase; }
  h3 { margin-bottom: 1rem; font-size: clamp(1.7rem, 3vw, 2.35rem); }
  p { color: var(--muted); font-size: .9rem; }
  .article-bottom { margin-top: 1.5rem; border-top: 1px solid var(--border); padding-top: 1rem; }
  time { color: var(--muted); font-size: .7rem; }
  .article-arrow { display: grid; width: 2.75rem; height: 2.75rem; place-items: center; border-radius: 50%; background: var(--surface); color: var(--greenDark); font-size: 1.2rem; transition: background-color .2s ease, transform .2s ease; }
  .article-arrow:hover { transform: rotate(-20deg); background: var(--yellow); }
  .featured { display: grid; grid-template-columns: 1.15fr 1fr; }
  .featured .article-image img { height: 100%; aspect-ratio: auto; }
  .featured .article-body { display: flex; flex-direction: column; justify-content: center; padding: clamp(2rem, 4vw, 4rem); }
  .featured .article-bottom { margin-top: auto; }
  @media (max-width: 720px) { .featured { grid-template-columns: 1fr; } .featured .article-image img { aspect-ratio: 1.35; } }
</style>
