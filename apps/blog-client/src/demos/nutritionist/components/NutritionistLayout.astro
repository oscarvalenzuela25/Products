---
import theme from "../styles/theme";
import DemoSelector from "../../../components/DemoSelector/DemoSelector";
import useDemo from "../../../hooks/useDemo";

interface Props {
  title: string;
  description: string;
  currentPath?: string;
  image?: string;
  noIndex?: boolean;
}

const {
  title,
  description,
  currentPath = "",
  image = "/og.png",
  noIndex = false,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin);
const socialImage = new URL(image, Astro.site ?? Astro.url.origin);
const { isDemo, availableDemos } = useDemo();
const navItems = [
  { href: "/", label: "Inicio", match: "/" },
  { href: "/about", label: "Sobre mí", match: "/about" },
  { href: "/services", label: "Consultas", match: "/services" },
  { href: "/projects", label: "Historias", match: "/projects" },
  { href: "/blog", label: "Recursos", match: "/blog" },
];

const schema = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: "Claudia Valenzuela",
  jobTitle: "Nutricionista",
  description,
  knowsAbout: [
    "Nutrición clínica",
    "Conducta alimentaria",
    "Nutrición digestiva",
    "Educación alimentaria",
  ],
  address: {
    "@type": "PostalAddress",
    addressLocality: "Providencia",
    addressRegion: "Región Metropolitana",
    addressCountry: "CL",
  },
};
---

<!doctype html>
<html lang="es-CL">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="robots" content={noIndex ? "noindex, nofollow" : "index, follow, max-image-preview:large"} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Newsreader:opsz,wght@6..72,400;6..72,500;6..72,600&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_CL" />
    <meta property="og:site_name" content="Claudia Valenzuela Nutrición" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <title>{title}</title>
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  </head>
  <body>
    <a class="skip-link" href="#contenido">Saltar al contenido</a>
    {isDemo && (
      <DemoSelector
        client:load
        availableDemos={availableDemos}
        currentDemoKey="nutritionist"
      />
    )}
    <header class="site-header">
      <div class="announcement">
        <p>
          <span class="announcement-dot" aria-hidden="true"></span>
          Agenda abierta · Consultas online y en Providencia
        </p>
      </div>
      <div class="nav-wrap shell">
        <a class="brand" href="/" aria-label="Claudia Valenzuela Nutrición, inicio">
          <span class="brand-mark" aria-hidden="true"><i></i><b></b></span>
          <span>
            <strong>Claudia Valenzuela</strong>
            <small>Nutrición consciente</small>
          </span>
        </a>
        <nav class="desktop-nav" aria-label="Navegación principal">
          {navItems.map((item) => (
            <a
              href={item.href}
              class:list={{ active: currentPath === item.match }}
              aria-current={currentPath === item.match ? "page" : undefined}
            >
              {item.label}
            </a>
          ))}
        </nav>
        <a class="button button-small desktop-cta" href="/contact">Reservar hora <span aria-hidden="true">↗</span></a>
        <details class="mobile-menu">
          <summary aria-label="Abrir menú de navegación"><span></span><span></span></summary>
          <nav aria-label="Navegación móvil">
            {navItems.map((item) => (
              <a href={item.href} aria-current={currentPath === item.match ? "page" : undefined}>{item.label}</a>
            ))}
            <a class="button" href="/contact">Reservar hora</a>
          </nav>
        </details>
      </div>
    </header>

    <main id="contenido" tabindex="-1">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="footer-grid shell">
        <div class="footer-intro">
          <a class="brand brand-light" href="/" aria-label="Claudia Valenzuela Nutrición, inicio">
            <span class="brand-mark" aria-hidden="true"><i></i><b></b></span>
            <span><strong>Claudia Valenzuela</strong><small>Nutrición consciente</small></span>
          </a>
          <p>Comer bien también puede sentirse bien. Acompañamiento nutricional cercano, práctico y basado en evidencia.</p>
        </div>
        <div>
          <h2>Explora</h2>
          <a href="/about">Sobre mí</a>
          <a href="/services">Consultas</a>
          <a href="/projects">Historias</a>
          <a href="/blog">Recursos</a>
        </div>
        <div>
          <h2>Contacto</h2>
          <a href="mailto:hola@claudiarinutricion.cl">hola@claudiarinutricion.cl</a>
          <a href="tel:+56961234567">+56 9 6123 4567</a>
          <p>Av. Los Leones 1450<br />Providencia, Santiago</p>
        </div>
        <div class="footer-cta">
          <p class="eyebrow eyebrow-light">Tu primer paso</p>
          <h2>¿Conversamos sobre lo que necesitas?</h2>
          <a class="button button-accent" href="/contact">Agendar una consulta <span aria-hidden="true">→</span></a>
        </div>
      </div>
      <div class="footer-bottom shell">
        <p>© 2026 Claudia Valenzuela. Sitio demostrativo.</p>
        <div><a href="/privacy-policy">Privacidad</a><a href="/terms-and-conditions">Términos</a></div>
      </div>
    </footer>
  </body>
</html>

<style is:global define:vars={{
  green: theme.primary.main,
  greenDark: theme.primary.dark,
  greenLight: theme.primary.light,
  sage: theme.primary[300],
  lime: theme.secondary.main,
  limeLight: theme.secondary.light,
  terracotta: theme.tertiary.main,
  terracottaLight: theme.tertiary.light,
  yellow: theme.accent.main,
  cream: theme.background.default,
  surface: theme.background.surface,
  paper: theme.background.paper,
  text: theme.text.primary,
  muted: theme.text.secondary,
  border: theme.border.default,
}}>
  :root {
    color-scheme: light;
    --font-display: "Newsreader", Georgia, serif;
    --font-body: "Plus Jakarta Sans", sans-serif;
    --shadow-soft: 0 18px 60px rgba(23, 63, 49, 0.1);
    --radius-lg: 2rem;
    --radius-md: 1.25rem;
  }

  * { box-sizing: border-box; }
  html { scroll-behavior: smooth; background: var(--cream); }
  body {
    margin: 0;
    min-width: 320px;
    background: var(--cream);
    color: var(--text);
    font-family: var(--font-body);
    font-size: 1rem;
    line-height: 1.65;
    -webkit-font-smoothing: antialiased;
  }
  img { display: block; max-width: 100%; }
  a { color: inherit; text-decoration: none; }
  button, input, textarea, select { font: inherit; }
  h1, h2, h3, p { margin-top: 0; }
  h1, h2, h3 {
    font-family: var(--font-display);
    font-weight: 500;
    line-height: 1.02;
    letter-spacing: -0.035em;
  }
  h1 { font-size: clamp(3.3rem, 8vw, 7.2rem); }
  h2 { font-size: clamp(2.45rem, 5vw, 4.8rem); }
  h3 { font-size: clamp(1.55rem, 2.4vw, 2.25rem); }
  :focus-visible { outline: 3px solid var(--terracotta); outline-offset: 4px; }
  :target, :focus { scroll-margin-top: 8rem; }
  ::selection { background: var(--yellow); color: var(--greenDark); }

  .shell { width: min(1180px, calc(100% - 2rem)); margin-inline: auto; }
  .section { padding: clamp(5rem, 9vw, 9rem) 0; }
  .section-tight { padding: clamp(3.5rem, 7vw, 6rem) 0; }
  .section-surface { background: var(--surface); }
  .section-dark { background: var(--greenDark); color: white; }
  .eyebrow {
    display: flex;
    align-items: center;
    gap: .65rem;
    margin-bottom: 1.25rem;
    color: var(--green);
    font-size: .73rem;
    font-weight: 700;
    letter-spacing: .14em;
    line-height: 1.2;
    text-transform: uppercase;
  }
  .eyebrow::before { content: ""; width: 2.2rem; height: 1px; background: currentColor; }
  .eyebrow-light { color: var(--sage); }
  .lead { color: var(--muted); font-size: clamp(1.08rem, 2vw, 1.35rem); line-height: 1.7; }
  .button {
    display: inline-flex;
    min-height: 3.35rem;
    align-items: center;
    justify-content: center;
    gap: .7rem;
    border: 1px solid var(--greenDark);
    border-radius: 999px;
    padding: .85rem 1.5rem;
    background: var(--greenDark);
    color: white;
    font-size: .9rem;
    font-weight: 700;
    transition: transform .25s ease, background-color .25s ease, color .25s ease;
  }
  .button:hover { transform: translateY(-2px); background: var(--green); }
  .button-small { min-height: 2.75rem; padding: .65rem 1.15rem; font-size: .8rem; }
  .button-light { border-color: white; background: white; color: var(--greenDark); }
  .button-light:hover { background: var(--limeLight); color: var(--greenDark); }
  .button-outline { background: transparent; color: var(--greenDark); }
  .button-outline:hover { background: var(--greenDark); color: white; }
  .button-accent { border-color: var(--yellow); background: var(--yellow); color: var(--greenDark); }
  .button-accent:hover { background: var(--lime); }
  .text-link { display: inline-flex; align-items: center; gap: .5rem; color: var(--greenDark); font-weight: 700; }
  .text-link span { transition: transform .2s ease; }
  .text-link:hover span { transform: translateX(.3rem); }
  .skip-link {
    position: fixed;
    z-index: 1000;
    top: .75rem;
    left: .75rem;
    transform: translateY(-160%);
    border-radius: .5rem;
    padding: .75rem 1rem;
    background: var(--yellow);
    color: var(--greenDark);
    font-weight: 700;
  }
  .skip-link:focus { transform: translateY(0); }

  .site-header { position: relative; z-index: 30; background: rgba(251, 248, 239, .92); }
  .announcement { display: grid; min-height: 2.15rem; place-items: center; background: var(--greenDark); color: white; }
  .announcement p { margin: 0; padding: .35rem 1rem; font-size: .7rem; font-weight: 600; letter-spacing: .05em; text-align: center; }
  .announcement-dot { display: inline-block; width: .45rem; height: .45rem; margin-right: .45rem; border-radius: 50%; background: var(--lime); box-shadow: 0 0 0 .2rem rgba(168, 198, 108, .15); }
  .nav-wrap { display: flex; min-height: 5.4rem; align-items: center; gap: 2rem; }
  .brand { display: inline-flex; align-items: center; gap: .7rem; margin-right: auto; }
  .brand strong, .brand small { display: block; }
  .brand strong { font-family: var(--font-display); font-size: 1.18rem; font-weight: 600; line-height: 1; }
  .brand small { margin-top: .25rem; color: var(--muted); font-size: .58rem; font-weight: 600; letter-spacing: .1em; text-transform: uppercase; }
  .brand-mark { position: relative; display: block; width: 2.15rem; height: 2.15rem; border-radius: 50% 50% 45% 55%; background: var(--limeLight); transform: rotate(-5deg); }
  .brand-mark::after { content: ""; position: absolute; left: 1.02rem; top: .8rem; width: 2px; height: .85rem; background: var(--greenDark); transform: rotate(-8deg); }
  .brand-mark i, .brand-mark b { position: absolute; top: .62rem; width: .75rem; height: .48rem; background: var(--green); }
  .brand-mark i { left: .37rem; border-radius: 80% 10% 70% 20%; transform: rotate(28deg); }
  .brand-mark b { right: .3rem; border-radius: 10% 80% 20% 70%; transform: rotate(-25deg); }
  .desktop-nav { display: flex; align-items: center; gap: 1.6rem; }
  .desktop-nav a { position: relative; padding: .75rem 0; color: var(--muted); font-size: .78rem; font-weight: 700; }
  .desktop-nav a::after { content: ""; position: absolute; right: 0; bottom: .45rem; left: 0; height: 2px; background: var(--terracotta); transform: scaleX(0); transition: transform .2s ease; }
  .desktop-nav a:hover, .desktop-nav a.active { color: var(--text); }
  .desktop-nav a:hover::after, .desktop-nav a.active::after { transform: scaleX(1); }
  .mobile-menu { display: none; }

  .site-footer { overflow: hidden; padding-top: clamp(4.5rem, 8vw, 7rem); background: var(--greenDark); color: white; }
  .footer-grid { display: grid; grid-template-columns: 1.55fr .7fr 1fr 1.45fr; gap: clamp(2rem, 5vw, 5rem); }
  .brand-light small, .site-footer p { color: rgba(255,255,255,.68); }
  .footer-intro > p { max-width: 20rem; margin-top: 1.75rem; }
  .site-footer h2 { margin-bottom: 1.25rem; font-family: var(--font-body); font-size: .74rem; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; }
  .site-footer a:not(.button):not(.brand) { display: block; width: fit-content; margin: .65rem 0; color: rgba(255,255,255,.76); font-size: .88rem; }
  .site-footer a:not(.button):not(.brand):hover { color: var(--yellow); }
  .footer-cta { margin-top: -1rem; border: 1px solid rgba(255,255,255,.15); border-radius: var(--radius-md); padding: 2rem; background: rgba(255,255,255,.05); }
  .footer-cta h2 { margin-bottom: 1.5rem; font-family: var(--font-display); font-size: 2rem; font-weight: 500; letter-spacing: -.03em; text-transform: none; }
  .footer-bottom { display: flex; align-items: center; justify-content: space-between; margin-top: 4rem; border-top: 1px solid rgba(255,255,255,.12); padding: 1.35rem 0; }
  .footer-bottom p { margin: 0; font-size: .7rem; }
  .footer-bottom div { display: flex; gap: 1.25rem; }
  .footer-bottom a { margin: 0 !important; font-size: .7rem !important; }

  @media (max-width: 900px) {
    .desktop-nav, .desktop-cta { display: none; }
    .mobile-menu { display: block; }
    .mobile-menu summary { display: grid; width: 2.8rem; height: 2.8rem; cursor: pointer; list-style: none; place-content: center; gap: .35rem; border: 1px solid var(--border); border-radius: 50%; }
    .mobile-menu summary::-webkit-details-marker { display: none; }
    .mobile-menu summary span { display: block; width: 1rem; height: 2px; background: var(--greenDark); }
    .mobile-menu nav { position: absolute; right: 1rem; left: 1rem; top: calc(100% - .4rem); display: grid; gap: .25rem; border: 1px solid var(--border); border-radius: 1rem; padding: 1rem; background: var(--cream); box-shadow: var(--shadow-soft); }
    .mobile-menu nav a:not(.button) { padding: .75rem; border-bottom: 1px solid var(--border); font-weight: 600; }
    .footer-grid { grid-template-columns: 1.3fr 1fr; }
  }

  @media (max-width: 600px) {
    .shell { width: min(100% - 1.25rem, 1180px); }
    .announcement p {
      width: 100%;
      overflow: hidden;
      padding-right: 9.5rem;
      font-size: .62rem;
      text-align: left;
      text-overflow: ellipsis;
      white-space: nowrap;
    }
    .nav-wrap { min-height: 4.8rem; }
    .brand strong { font-size: 1.05rem; }
    .brand small { font-size: .52rem; }
    .footer-grid { grid-template-columns: 1fr; }
    .footer-intro { margin-bottom: 1rem; }
    .footer-cta { margin-top: 0; }
    .footer-bottom { align-items: flex-start; flex-direction: column; gap: .75rem; }
  }

  @media (prefers-reduced-motion: reduce) {
    html { scroll-behavior: auto; }
    *, *::before, *::after { animation-duration: .01ms !important; animation-iteration-count: 1 !important; transition-duration: .01ms !important; }
  }
</style>
